body.catalog-master-site-preview .catalog-master-preview-hero:after {
  background:
    linear-gradient(90deg,rgba(5,13,24,.98) 0%,rgba(5,13,24,.92) 28%,rgba(5,13,24,.54) 58%,rgba(5,13,24,.40) 100%),
    var(--master-preview-hero-image, url("../assets/img/hero-cover.webp")) center right/cover no-repeat;
}

.catalog-master-preview-meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  margin-top: 24px;
}

.catalog-master-preview-meta article,
.catalog-master-system-block,
.catalog-master-filter-card,
.catalog-master-product-group-row {
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 16px;
  background: rgba(255,255,255,.055);
}

.catalog-master-preview-meta article {
  padding: 16px;
}

.catalog-master-preview-meta b {
  display: block;
  font-size: 26px;
  color: #fff;
  line-height: 1;
  margin-bottom: 6px;
}

.catalog-master-product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.catalog-master-product-card {
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  gap: 18px;
  min-height: 260px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 18px;
  overflow: hidden;
  background: linear-gradient(145deg,rgba(255,255,255,.09),rgba(255,255,255,.035));
  box-shadow: 0 18px 55px rgba(0,0,0,.22);
}

.catalog-master-product-card .mini-visual {
  min-height: 100%;
  background: #071223;
}

.catalog-master-product-card .mini-visual img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.catalog-master-product-copy {
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-width: 0;
  padding: 20px 20px 20px 0;
}

.catalog-master-product-copy > span,
.catalog-master-card-chip-title {
  display: block;
  color: #d6a8b9;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.catalog-master-product-copy h3 {
  font-size: 24px;
  letter-spacing: -.02em;
}

.catalog-master-product-copy p {
  color: #c9d5e5;
  line-height: 1.54;
  margin: 0;
}

.catalog-master-system-block {
  margin-top: 22px;
  padding: 22px;
}

.catalog-master-system-block h3 {
  font-size: 28px;
  margin-bottom: 14px;
}

.catalog-master-system-nav,
.catalog-master-chip-row,
.catalog-master-product-type-tags,
.django-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.catalog-master-system-nav a,
.catalog-master-chip,
.django-chip-row span,
.catalog-master-product-type-tags span {
  display: inline-flex;
  align-items: center;
  min-height: 30px;
  padding: 7px 10px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 999px;
  background: rgba(255,255,255,.055);
  color: #d9e3f1;
  font-size: 12px;
  font-weight: 850;
}

.catalog-master-group-list {
  display: grid;
  gap: 10px;
}

.catalog-master-product-group-row {
  display: block;
  padding: 14px;
}

.catalog-master-product-group-row b {
  display: block;
  margin-bottom: 8px;
}

.catalog-master-filter-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.catalog-master-filter-card {
  padding: 16px;
}

.catalog-master-filter-card b {
  display: block;
  font-size: 17px;
  margin-bottom: 8px;
}

.catalog-master-filter-card p {
  margin: 0;
  color: #c9d5e5;
  font-size: 13px;
  line-height: 1.45;
}

.django-logo-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 12px;
}

.partners-preview.popular-logo-grid {
  display: grid !important;
  grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
  grid-auto-rows: 88px !important;
  gap: 12px !important;
}

.partners-preview.popular-logo-grid > .logo-tile {
  width: auto !important;
  height: 88px !important;
  min-height: 88px !important;
}

.django-logo-grid .logo-tile {
  min-height: 96px;
}

.partner-card .partner-meta,
.vendor-direction-card .partner-meta {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.55;
}

.partners-filter-panel {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 20px;
  align-items: center;
  margin-bottom: 24px;
  border: 1px solid rgba(255,255,255,.13);
  border-radius: 24px;
  background:
    radial-gradient(circle at 50% 38%, rgba(109,32,57,.24), transparent 38%),
    linear-gradient(145deg, rgba(255,255,255,.085), rgba(255,255,255,.03));
  box-shadow: 0 18px 54px rgba(0,0,0,.18);
  padding: 28px 28px 26px;
  transition: opacity .18s ease;
}

.partners-filter-panel.is-loading {
  opacity: .72;
}

.partners-search-card,
.partners-category-card {
  min-width: 0;
}

.partners-search-card {
  width: min(100%, 680px);
  display: grid;
  align-content: center;
  justify-items: center;
  gap: 12px;
  z-index: 1;
}

.partners-search-card label {
  color: var(--muted);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.partners-search-control {
  display: grid;
  width: 100%;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 10px;
}

.partners-search-control input {
  width: 100%;
  height: 64px;
  min-width: 0;
  border-radius: 10px;
  font-size: 17px;
  font-weight: 750;
  padding-inline: 18px;
}

.partners-search-control .btn {
  min-width: 126px;
  box-shadow: none;
}

.partners-category-card {
  width: 100%;
  min-width: 0;
}

.partners-category-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px 12px;
  width: 100%;
  min-width: 0;
}

.partner-category-chip {
  display: inline-flex;
  min-width: 0;
  cursor: pointer;
}

button.partner-category-chip {
  appearance: none;
  border: 0;
  background: transparent;
  font: inherit;
  padding: 0;
}

.partner-category-chip input {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.partner-category-chip span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 56px;
  min-width: 0;
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 999px;
  background: rgba(255,255,255,.07);
  color: #f6f7fb;
  font-size: 14px;
  font-weight: 850;
  line-height: 1.2;
  padding: 10px 14px 10px 18px;
  transition: background .18s ease, border-color .18s ease, color .18s ease, transform .18s ease, box-shadow .18s ease;
}

.partner-category-chip i {
  display: block;
  max-width: 176px;
  overflow: hidden;
  font-style: normal;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.partner-category-chip b {
  display: inline-grid;
  place-items: center;
  min-width: 29px;
  height: 29px;
  border-radius: 999px;
  background: rgba(255,255,255,.16);
  color: #fff;
  font-size: 12px;
  font-weight: 950;
  line-height: 1;
  padding-inline: 7px;
}

.partner-category-chip:hover span {
  border-color: rgba(214,168,185,.46);
  background: rgba(109,32,57,.20);
  transform: translateY(-1px);
}

.partner-category-chip input:checked + span {
  border-color: rgba(214,168,185,.82);
  background: linear-gradient(135deg, #c13c70, #8d214b);
  color: #fff;
  box-shadow: 0 16px 34px rgba(109,32,57,.28), inset 0 0 0 1px rgba(255,255,255,.07);
}

.partner-category-chip.is-active span,
.partner-category-clear:hover span {
  border-color: rgba(214,168,185,.82);
  background: linear-gradient(135deg, #c13c70, #8d214b);
  color: #fff;
  box-shadow: 0 16px 34px rgba(109,32,57,.28), inset 0 0 0 1px rgba(255,255,255,.07);
}

.partner-category-chip.is-active span b,
.partner-category-clear:hover span b {
  background: rgba(255,255,255,.22);
}

.partner-category-chip input:checked + span b {
  background: rgba(255,255,255,.22);
}

.partners-results-grid {
  margin-top: 22px;
}

.partners-pagination {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  margin-top: 24px;
}

.partner-page-link,
.partner-page-current {
  min-width: 44px;
  min-height: 42px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 10px 16px;
  font-size: 14px;
  font-weight: 850;
}

.partner-page-link {
  border: 1px solid rgba(214,168,185,.34);
  background: rgba(109,32,57,.22);
  color: #fff;
  text-decoration: none;
  transition: background .18s ease, border-color .18s ease, transform .18s ease;
}

.partner-page-link:hover {
  border-color: rgba(214,168,185,.58);
  background: rgba(109,32,57,.34);
  transform: translateY(-1px);
}

.partner-page-current {
  border: 1px solid rgba(255,255,255,.12);
  background: rgba(255,255,255,.055);
  color: var(--muted);
}

.vendor-row,
.vendor-row > *,
.vendor-brands,
.all-manufacturer-cloud {
  min-width: 0;
}

.vendor-chip,
.vendor-meta b,
.vendor-meta small {
  max-width: 100%;
  white-space: normal;
  overflow-wrap: anywhere;
}

.vendor-toolbar.vendor-toolbar-main {
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  align-items: end !important;
  gap: 14px !important;
}

.vendor-toolbar-main .field,
.vendor-toolbar-main input,
.vendor-toolbar-main select {
  min-width: 0;
}

.vendor-toolbar-main .vendor-search-field {
  grid-column: auto;
}

.vendor-toolbar-main .vendor-block-field {
  grid-column: auto;
}

.vendor-toolbar-main .vendor-direction-field {
  grid-column: auto;
}

.vendor-toolbar-main .vendor-system-field {
  grid-column: auto;
}

.vendor-toolbar-main .vendor-group-field {
  grid-column: auto;
}

.vendor-actions-field {
  display: contents;
}

.vendor-toolbar-main label {
  display: block;
  min-height: 30px;
  line-height: 1.2;
}

.vendor-toolbar-main input,
.vendor-toolbar-main select {
  overflow: hidden;
  text-overflow: ellipsis;
}

.vendor-filter-native {
  display: none !important;
}

.vendor-search-control {
  position: relative;
}

.vendor-custom-select {
  position: relative;
}

.vendor-select-button,
.vendor-toolbar-main input,
.vendor-actions-field .btn {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  height: 64px;
  min-height: 64px;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 12px;
  background: rgba(255,255,255,.065);
  color: #fff;
  font: inherit;
  font-weight: 750;
  padding: 13px 40px 13px 15px;
  text-align: left;
  line-height: 1.18;
  overflow: hidden;
}

.vendor-select-button {
  appearance: none;
  position: relative;
  cursor: pointer;
}

.vendor-select-button span,
.vendor-toolbar-main input {
  min-width: 0;
  max-width: 100%;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vendor-toolbar-main input {
  display: block;
  white-space: nowrap;
}

.vendor-actions-field .btn {
  justify-content: center;
  padding: 13px 16px;
  white-space: nowrap;
}

.vendor-select-button::after {
  content: "";
  position: absolute;
  right: 16px;
  top: 50%;
  width: 9px;
  height: 9px;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: translateY(-65%) rotate(45deg);
  opacity: .88;
}

.vendor-custom-select.is-open .vendor-select-button {
  border-color: rgba(214,168,185,.52);
  background: rgba(255,255,255,.09);
}

.vendor-suggestions {
  position: absolute;
  z-index: 20;
  top: calc(100% + 8px);
  left: 0;
  right: 0;
  display: grid;
  gap: 4px;
  max-height: 260px;
  overflow: auto;
  padding: 8px;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 14px;
  background: #1d1930;
  box-shadow: 0 18px 42px rgba(0,0,0,.34);
}

.vendor-select-menu {
  position: absolute;
  z-index: 18;
  top: calc(100% + 8px);
  left: 0;
  right: 0;
  display: grid;
  gap: 3px;
  max-height: 230px;
  overflow: auto;
  padding: 7px;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 14px;
  background: #1d1930;
  box-shadow: 0 18px 42px rgba(0,0,0,.34);
}

.vendor-suggestions[hidden] {
  display: none;
}

.vendor-select-menu[hidden] {
  display: none;
}

.vendor-suggestions button,
.vendor-select-menu button {
  appearance: none;
  width: 100%;
  min-height: 34px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: #fff;
  cursor: pointer;
  font: inherit;
  font-size: 13px;
  font-weight: 750;
  line-height: 1.25;
  padding: 8px 10px;
  text-align: left;
}

.vendor-suggestions button:hover,
.vendor-suggestions button:focus-visible,
.vendor-select-menu button:hover,
.vendor-select-menu button:focus-visible,
.vendor-select-menu button.is-selected {
  background: rgba(255,255,255,.10);
  outline: none;
}

.vendor-selected-fields {
  display: none;
}

.vendor-toolbar-main .vendor-count {
  grid-column: 1 / -1 !important;
  text-align: left;
}

button.vendor-chip {
  appearance: none;
  border-radius: 999px;
  cursor: pointer;
  font: inherit;
  text-align: left;
}

.vendor-chip.is-selected {
  border-color: rgba(214,168,185,.86);
  background: linear-gradient(135deg, #c13c70, #8d214b);
  color: #fff;
  box-shadow: 0 14px 28px rgba(109,32,57,.24), inset 0 0 0 1px rgba(255,255,255,.07);
}

button.vendor-chip.is-selected:hover,
button.vendor-chip.is-selected:focus-visible {
  border-color: rgba(214,168,185,.96);
  background: linear-gradient(135deg, #c13c70, #8d214b);
  color: #fff;
  box-shadow: 0 16px 30px rgba(109,32,57,.30), inset 0 0 0 1px rgba(255,255,255,.10);
}

.vendor-row-actions {
  margin-top: 12px;
}

.vendor-rows-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin-top: 24px;
  flex-wrap: wrap;
}

.vendor-rows-page-link,
.vendor-rows-page-current {
  min-height: 42px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 10px 16px;
  font-size: 14px;
  font-weight: 850;
}

.vendor-rows-page-link {
  border: 1px solid rgba(214,168,185,.34);
  background: rgba(109,32,57,.22);
  color: #fff;
  text-decoration: none;
  transition: background .18s ease, border-color .18s ease, transform .18s ease;
}

.vendor-rows-page-link:hover {
  border-color: rgba(214,168,185,.58);
  background: rgba(109,32,57,.34);
  transform: translateY(-1px);
}

.vendor-rows-page-current {
  border: 1px solid rgba(255,255,255,.12);
  background: rgba(255,255,255,.055);
  color: var(--muted);
}

@media (max-width: 1320px) {
  .vendor-toolbar.vendor-toolbar-main {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  }

  .vendor-toolbar-main label {
    min-height: 30px;
  }
}

@media (max-width: 1080px) {
  .partners-filter-panel {
    align-items: center;
  }

  .partners-category-list {
    justify-content: center;
  }
}

@media (max-width: 920px) {
  .vendor-toolbar.vendor-toolbar-main {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }

  .vendor-toolbar-main label {
    min-height: 0;
  }
}

@media (max-width: 760px) {
  .vendor-toolbar.vendor-toolbar-main {
    grid-template-columns: 1fr !important;
  }

  .partners-filter-panel {
    padding: 18px;
    gap: 18px;
  }

  .partners-search-card {
    justify-items: stretch;
  }

  .partners-search-control {
    grid-template-columns: 1fr;
  }

  .partners-search-control input {
    height: 58px;
  }

  .partners-search-control .btn {
    width: 100%;
  }

  .partners-category-list {
    flex-wrap: nowrap;
    justify-content: flex-start;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 4px;
  }

  .partner-category-chip {
    flex: 0 0 auto;
  }
}

.mini-request-form {
  display: grid;
  gap: 14px;
}

.mini-request-form .form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.mini-request-form .field span,
.mini-request-form .field label {
  color: var(--muted);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.mini-request-form input[type="file"] {
  min-height: 48px;
}

.type-list {
  display: grid;
  gap: 10px;
}

.type-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  width: 100%;
  padding: 15px 16px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 12px;
  color: #fff;
  background: rgba(255,255,255,.055);
  cursor: pointer;
  text-align: left;
}

.type-item:hover,
.type-item.is-selected {
  border-color: rgba(214,168,185,.68);
  background: rgba(109,32,57,.22);
}

.type-item small {
  color: #d6a8b9;
  font-weight: 900;
}

.request-status,
.form-status {
  min-height: 24px;
  margin: 0;
  color: #9ee6b8;
  font-weight: 800;
}

.request-status.is-error,
.form-status.is-error {
  color: #ffb1c5;
}

.home-request-form {
  display: grid;
  gap: 12px;
  margin-top: 18px;
}

.home-request-form .form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.home-request-form textarea {
  min-height: 96px;
}

.file-input {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.file-field .upload-box {
  display: block;
  cursor: pointer;
  transition: border-color .18s ease, background .18s ease, transform .18s ease;
}

.file-field .upload-box:hover {
  border-color: rgba(255,255,255,.48);
  background: rgba(255,255,255,.055);
  transform: translateY(-1px);
}

.file-field .upload-box span {
  display: block;
  color: #fff;
  font-weight: 850;
}

.file-field .upload-box small {
  display: block;
  margin-top: 6px;
}

.file-warning {
  margin: 8px 0 0;
  color: #d9c1cc;
  font-size: 12px;
  line-height: 1.45;
}

.file-list {
  display: grid;
  gap: 8px;
  margin-top: 10px;
}

.file-list[hidden] {
  display: none;
}

.file-list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 42px;
  padding: 9px 10px 9px 13px;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 12px;
  background: rgba(255,255,255,.075);
}

.file-list-meta {
  min-width: 0;
  color: #fff;
  font-size: 13px;
  font-weight: 800;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-list-remove {
  appearance: none;
  display: inline-grid;
  place-items: center;
