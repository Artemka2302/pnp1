}

.catalog-section {
  padding-top: clamp(38px, 5vw, 64px);
}

.catalog-layout {
  display: grid;
  grid-template-columns: minmax(280px, 330px) minmax(0, 1fr);
  gap: 24px;
  align-items: start;
}

.catalog-side-panel {
  position: sticky;
  top: 92px;
  max-height: calc(100vh - 112px);
  overflow: auto;
  border: 1px solid rgba(255,255,255,.13);
  border-radius: 18px;
  background:
    linear-gradient(145deg, rgba(255,255,255,.075), rgba(255,255,255,.028)),
    rgba(10, 24, 43, .88);
  box-shadow: 0 22px 64px rgba(0,0,0,.24);
  padding: 14px;
  scrollbar-width: thin;
}

.catalog-search-box {
  position: relative;
  margin-bottom: 12px;
}

.catalog-search-box label {
  display: block;
  margin: 0 0 8px;
  color: #91a5c3;
  font-size: 11px;
  font-weight: 950;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.catalog-search-control {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 38px;
  gap: 8px;
}

.catalog-search-control input,
.catalog-search-control button {
  min-width: 0;
  height: 46px;
  border: 1px solid rgba(255,255,255,.16);
  border-radius: 12px;
  background: rgba(255,255,255,.065);
  color: #fff;
}

.catalog-search-control input {
  padding: 0 13px;
  font-weight: 750;
}

.catalog-search-control button {
  cursor: pointer;
  font-size: 22px;
  line-height: 1;
}

.catalog-search-results {
  position: absolute;
  z-index: 12;
  top: calc(100% + 8px);
  left: 0;
  right: 0;
  display: grid;
  gap: 6px;
  max-height: 360px;
  overflow: auto;
  padding: 8px;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 14px;
  background: #17243a;
  box-shadow: 0 24px 56px rgba(0,0,0,.38);
}

.catalog-search-results[hidden] {
  display: none;
}

.catalog-search-result {
  display: grid;
  gap: 4px;
  padding: 10px;
  border-radius: 10px;
  color: #fff;
  text-decoration: none;
}

.catalog-search-result:hover,
.catalog-search-result:focus-visible {
  background: rgba(255,255,255,.09);
  outline: none;
}

.catalog-search-result b {
  font-size: 14px;
}

.catalog-search-result span,
.catalog-search-result small {
  color: #9fb0c7;
  font-size: 11px;
  line-height: 1.25;
}

.catalog-tree {
  display: grid;
  gap: 4px;
}

.catalog-tree-node {
  min-width: 0;
}

.catalog-tree-row {
  display: grid;
  grid-template-columns: 26px minmax(0, 1fr) auto;
  gap: 8px;
  align-items: center;
  min-height: 38px;
  border-radius: 12px;
  padding: 4px 7px;
}

.catalog-tree-row:hover {
  background: rgba(255,255,255,.045);
}

.catalog-tree-row a {
  min-width: 0;
  overflow: hidden;
  color: #dbe6f3;
  font-size: 13px;
  font-weight: 850;
  line-height: 1.15;
  text-decoration: none;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.catalog-tree-row a:hover,
.catalog-tree-row a.is-active {
  color: #fff;
}

.catalog-tree-row a.is-active {
  text-shadow: 0 0 18px rgba(242,183,202,.30);
}

.catalog-tree-row span {
  color: #91a5c3;
  font-size: 9px;
  font-weight: 950;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.catalog-tree-toggle,
.catalog-tree-row i {
  width: 24px;
  height: 24px;
  border-radius: 999px;
}

.catalog-tree-toggle {
  position: relative;
  cursor: pointer;
  border: 1px solid rgba(214,168,185,.32);
  background: rgba(255,255,255,.06);
}

.catalog-tree-toggle::before,
.catalog-tree-toggle::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 9px;
  height: 2px;
  border-radius: 3px;
  background: #f2b7ca;
  transform: translate(-50%, -50%);
}

.catalog-tree-toggle::after {
  transform: translate(-50%, -50%) rotate(90deg);
  transition: opacity .16s ease;
}

.catalog-tree-node.is-open > .catalog-tree-row .catalog-tree-toggle::after {
  opacity: 0;
}

.catalog-tree-row i {
  display: block;
  background: radial-gradient(circle, #e4d6bd 0 24%, rgba(255,255,255,.11) 26% 100%);
}

.catalog-tree-children {
  display: none;
  margin-left: 16px;
  padding-left: 8px;
  border-left: 1px solid rgba(196,55,102,.26);
}

.catalog-tree-node.is-open > .catalog-tree-children {
  display: grid;
  gap: 2px;
}

.catalog-main {
  min-width: 0;
}

.catalog-level-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.catalog-block-grid {
  grid-template-columns: repeat(6, minmax(0, 1fr));
}

.catalog-block-grid .catalog-level-card {
  grid-column: span 2;
}

.catalog-block-grid .catalog-level-card:nth-child(1),
.catalog-block-grid .catalog-level-card:nth-child(2) {
  grid-column: span 3;
}

.catalog-level-card {
  display: grid;
  grid-template-rows: 190px 1fr;
  min-height: 430px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.13);
  border-radius: 16px;
  background:
    linear-gradient(145deg,rgba(255,255,255,.085),rgba(255,255,255,.032)),
    radial-gradient(circle at 0 0,rgba(196,55,102,.16),transparent 40%);
  box-shadow: 0 18px 54px rgba(0,0,0,.24);
  color: inherit;
  text-decoration: none;
  transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
}

.catalog-level-card:hover {
  transform: translateY(-5px);
  border-color: rgba(255,255,255,.30);
  box-shadow: 0 30px 76px rgba(0,0,0,.34);
}

.catalog-level-media {
  position: relative;
  overflow: hidden;
  background: #0a1628;
}

.catalog-level-media::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg,rgba(5,13,24,.04),rgba(5,13,24,.48)),
    linear-gradient(90deg,rgba(143,33,71,.20),transparent 36%);
}

.catalog-level-media img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: saturate(.94) contrast(1.05);
  transition: transform .26s ease;
}

.catalog-level-card:hover .catalog-level-media img {
  transform: scale(1.035);
}

.catalog-level-body {
  display: flex;
  flex-direction: column;
  min-height: 0;
  padding: 21px 20px 19px;
}

.catalog-level-kicker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
}

.catalog-level-kicker span {
  color: #f0adc4;
  font-size: 10px;
  font-weight: 950;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.catalog-level-kicker b {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: 12px;
  border: 1px solid rgba(196,55,102,.42);
  background: rgba(196,55,102,.14);
  color: #fff;
  font-size: 13px;
}

.catalog-level-body h3 {
  margin: 0 0 10px;
  color: #fff;
  font-size: clamp(23px, 2vw, 30px);
  line-height: 1.08;
}

.catalog-level-body p {
  margin: 0 0 16px;
  color: #cfdae9;
  font-size: 14px;
  line-height: 1.52;
}

.catalog-level-stats {
  margin: 0 0 12px;
}

.catalog-level-chips {
  margin-top: auto;
  padding-top: 4px;
}

.catalog-product-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(360px, .7fr);
  gap: 18px;
  align-items: start;
}

.catalog-product-card,
.catalog-mini-request {
  padding: clamp(22px, 2.4vw, 30px);
}

.catalog-product-card h2,
.catalog-mini-request h2 {
  margin: 8px 0 10px;
}

.catalog-product-card p {
  color: #cdd8e7;
  line-height: 1.55;
}

.catalog-type-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 20px;
}

.catalog-type-card {
  display: grid;
  gap: 6px;
  min-height: 96px;
  cursor: pointer;
  border: 1px solid rgba(255,255,255,.13);
  border-radius: 14px;
  background: rgba(255,255,255,.055);
  color: #fff;
  padding: 16px;
  text-align: left;
  transition: border-color .18s ease, background .18s ease, transform .18s ease;
}

.catalog-type-card:hover,
.catalog-type-card.is-selected {
  border-color: rgba(214,168,185,.62);
  background: rgba(109,32,57,.20);
  transform: translateY(-1px);
}

.catalog-type-card b {
  font-size: 17px;
  line-height: 1.2;
}

.catalog-type-card span {
  color: #f0adc4;
  font-size: 12px;
  font-weight: 850;
}

.catalog-product-vendors {
  margin-top: 42px;
}

.catalog-empty-state {
  padding: 28px;
}

@media (max-width: 1180px) {
  .catalog-layout {
    grid-template-columns: 1fr;
  }

  .catalog-side-panel {
    position: static;
    max-height: none;
  }

  .catalog-tree {
    max-height: 420px;
    overflow: auto;
  }
}

@media (max-width: 980px) {
  .catalog-block-grid,
  .catalog-level-grid,
  .catalog-product-grid {
    grid-template-columns: 1fr;
  }

  .catalog-block-grid .catalog-level-card,
  .catalog-block-grid .catalog-level-card:nth-child(1),
  .catalog-block-grid .catalog-level-card:nth-child(2) {
    grid-column: span 1;
  }
}

@media (max-width: 640px) {
  html,
  body {
    max-width: 100%;
    overflow-x: hidden;
  }

  .catalog-page {
    max-width: 100vw;
    overflow-x: hidden;
  }

  .catalog-page *,
  .catalog-page *::before,
  .catalog-page *::after {
    box-sizing: border-box;
  }

  .catalog-page .container,
  .catalog-page .catalog-hero > .container {
    box-sizing: border-box;
    width: min(calc(100% - 28px), var(--max));
    max-width: var(--max);
    min-width: 0;
  }

  .catalog-page .catalog-section,
  .catalog-page .catalog-layout,
  .catalog-page .catalog-main,
  .catalog-page .catalog-side-panel,
  .catalog-page .catalog-block-grid,
  .catalog-page .catalog-level-grid,
  .catalog-page .catalog-product-grid {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .catalog-page .catalog-hero {
    padding: 62px 0 34px;
  }

  .catalog-page .catalog-hero h1 {
    font-size: clamp(36px, 12vw, 48px);
    overflow-wrap: anywhere;
  }

  .catalog-page .catalog-hero p {
    overflow-wrap: anywhere;
  }

  .catalog-hero-meta {
    display: grid;
    grid-template-columns: 1fr;
  }

  .catalog-hero-meta span {
    justify-content: center;
    min-width: 0;
    text-align: center;
  }

  .catalog-level-card {
    min-height: auto;
    grid-template-rows: 172px auto;
  }

  .catalog-type-grid {
    grid-template-columns: 1fr;
  }

  .catalog-tree-row {
    grid-template-columns: 26px minmax(0, 1fr);
  }

  .catalog-tree-row span {
    grid-column: 2;
    margin-top: -6px;
  }

  .cookie-banner {
    left: 12px;
    right: 12px;
    width: auto;
    max-width: none;
    box-sizing: border-box;
    grid-template-columns: 1fr;
  }

  .cookie-banner-actions {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
  }

  .cookie-banner-actions .btn {
    width: 100%;
    min-width: 0;
    white-space: normal;
  }
}
