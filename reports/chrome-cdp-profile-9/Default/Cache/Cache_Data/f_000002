  border-radius: 50%;
  background: rgba(255,255,255,.14);
  color: #fff;
  cursor: pointer;
  font: inherit;
  font-size: 18px;
  font-weight: 900;
  line-height: 1;
}

.file-list-remove:hover {
  background: rgba(214,168,185,.28);
}

.form-assurance {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 12px;
}

.form-assurance span {
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 12px;
  padding: 12px;
  background: rgba(255,255,255,.06);
}

.form-assurance b,
.form-assurance small {
  display: block;
}

.form-assurance small,
.form-consent {
  color: var(--muted);
  line-height: 1.45;
}

.form-consent-check {
  display: grid;
  grid-template-columns: 22px 1fr;
  gap: 10px;
  align-items: start;
  margin: 2px 0 4px;
  color: #dfe8f4;
  font-size: 13px;
  line-height: 1.45;
}

.form-consent-check input {
  width: 18px;
  height: 18px;
  margin-top: 2px;
