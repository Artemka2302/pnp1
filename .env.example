DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_SECRET_KEY=change-me-for-production
TRUST_X_FORWARDED_FOR=False

# Production HTTPS settings. With DJANGO_DEBUG=False the core secure defaults
# are enabled automatically; uncomment only when you need explicit overrides.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False

# Bitrix24 incoming webhook URL with CRM access.
# Example: https://your-company.bitrix24.ru/rest/1/secret-code
BITRIX_WEBHOOK_URL=

# DeepSeek server-side AI assistant. Never expose the API key in templates or JS.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=25

# SQLite is the local default.
SQLITE_NAME=db.sqlite3

# PostgreSQL option via separate variables.
# DB_ENGINE=postgresql
# DB_NAME=pnp1
# DB_USER=pnp1
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=5432

# PostgreSQL option via single URL.
# DATABASE_URL=postgresql://pnp1:change-me@127.0.0.1:5432/pnp1
