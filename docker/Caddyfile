www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=604800"
		file_server
	}

	handle /media/* {
		respond 404
	}

	handle {
		# Keep PNP1 on a unique container name: the shared proxy network also
		# contains the LEANS web service, which has its own `web` alias.
		reverse_proxy pnp1-web-1:8000
	}
}

# Additional sites are isolated into their own virtual-host files. They share
# the one public Caddy instance but never bind their own 80/443 ports.
import /etc/caddy/sites/*.caddy
